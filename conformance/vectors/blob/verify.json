{
  "$schema": "../vector.schema.json",
  "format": "webway-vectors/v0",
  "kind": "blob/verify",
  "description": "Verify a Fetch reply stream. Input {\"hash\", \"size\" (from the reply), \"ranges\" (the reply's ranges), \"data\": {\"pattern\": n}, \"mutate\"?: {\"flip\": byte offset} | {\"truncate\": length} | {\"append\": hex}}. The stream is the honest encoding of data for ranges, then mutate applied to it. Output {\"verified\": ranges, \"missing\": ranges, \"complete\": bool}. A stream that ends early is accepted with what was verified. Reject BlobCorrupt (data does not match) or ProtocolError (bytes after the end).",
  "spec": "ext/blob.md#54-verification",
  "cases": [
    {
      "id": "whole",
      "description": "Whole blob",
      "requirements": [
        "BLOB-021"
      ],
      "input": {
        "hash": "blake3:d93c23eedaf165a7e0be908ba86f1a7a520d568d2d13cde787c8580c5c72cc54",
        "size": 100000,
        "ranges": [
          [
            0,
            7
          ]
        ],
        "data": {
          "pattern": 100000
        }
      },
      "expect": {
        "result": "accept",
        "output": {
          "verified": [
            [
              0,
              7
            ]
          ],
          "missing": [],
          "complete": true
        }
      }
    },
    {
      "id": "scattered",
      "description": "Two ranges",
      "requirements": [
        "BLOB-021"
      ],
      "input": {
        "hash": "blake3:d93c23eedaf165a7e0be908ba86f1a7a520d568d2d13cde787c8580c5c72cc54",
        "size": 100000,
        "ranges": [
          [
            1,
            2
          ],
          [
            4,
            6
          ]
        ],
        "data": {
          "pattern": 100000
        }
      },
      "expect": {
        "result": "accept",
        "output": {
          "verified": [
            [
              1,
              2
            ],
            [
              4,
              6
            ]
          ],
          "missing": [],
          "complete": true
        }
      }
    },
    {
      "id": "empty-blob",
      "description": "Empty blob, empty stream",
      "requirements": [
        "BLOB-021"
      ],
      "input": {
        "hash": "blake3:af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262",
        "size": 0,
        "ranges": [
          [
            0,
            1
          ]
        ],
        "data": {
          "pattern": 0
        }
      },
      "expect": {
        "result": "accept",
        "output": {
          "verified": [
            [
              0,
              1
            ]
          ],
          "missing": [],
          "complete": true
        }
      }
    },
    {
      "id": "single-block",
      "description": "Blob of one block",
      "requirements": [
        "BLOB-021"
      ],
      "input": {
        "hash": "blake3:1309d44c9edaf51147844a5f38f884225acb365d7a5b4de34ef328671b5c6af5",
        "size": 300,
        "ranges": [
          [
            0,
            1
          ]
        ],
        "data": {
          "pattern": 300
        }
      },
      "expect": {
        "result": "accept",
        "output": {
          "verified": [
            [
              0,
              1
            ]
          ],
          "missing": [],
          "complete": true
        }
      }
    },
    {
      "id": "last-block-proves-size",
      "description": "The last block alone verifies, which proves the size",
      "requirements": [
        "BLOB-024"
      ],
      "input": {
        "hash": "blake3:d93c23eedaf165a7e0be908ba86f1a7a520d568d2d13cde787c8580c5c72cc54",
        "size": 100000,
        "ranges": [
          [
            6,
            7
          ]
        ],
        "data": {
          "pattern": 100000
        }
      },
      "expect": {
        "result": "accept",
        "output": {
          "verified": [
            [
              6,
              7
            ]
          ],
          "missing": [],
          "complete": true
        }
      }
    },
    {
      "id": "cut",
      "description": "Stream ends inside block 2: blocks 0 and 1 are kept",
      "requirements": [
        "BLOB-021",
        "BLOB-040"
      ],
      "input": {
        "hash": "blake3:d93c23eedaf165a7e0be908ba86f1a7a520d568d2d13cde787c8580c5c72cc54",
        "size": 100000,
        "ranges": [
          [
            0,
            7
          ]
        ],
        "data": {
          "pattern": 100000
        },
        "mutate": {
          "truncate": 33060
        }
      },
      "expect": {
        "result": "accept",
        "output": {
          "verified": [
            [
              0,
              2
            ]
          ],
          "missing": [
            [
              2,
              7
            ]
          ],
          "complete": false
        }
      }
    },
    {
      "id": "cut-empty",
      "description": "Nothing arrived",
      "requirements": [
