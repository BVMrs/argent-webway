          [
            0,
            7
          ]
        ],
        "data": {
          "pattern": 100000
        },
        "mutate": {
          "truncate": 0
        }
      },
      "expect": {
        "result": "accept",
        "output": {
          "verified": [],
          "missing": [
            [
              0,
              7
            ]
          ],
          "complete": false
        }
      }
    },
    {
      "id": "resume",
      "description": "The missing ranges of the cut case, fetched again (possibly from another provider)",
      "requirements": [
        "BLOB-040"
      ],
      "input": {
        "hash": "blake3:d93c23eedaf165a7e0be908ba86f1a7a520d568d2d13cde787c8580c5c72cc54",
        "size": 100000,
        "ranges": [
          [
            2,
