  "cases": [
    {
      "id": "one",
      "description": "One block",
      "requirements": [
        "BLOB-023"
      ],
      "input": {
        "ranges": [
          [
            0,
            1
          ]
        ],
        "size": 100000
      },
      "expect": {
        "result": "accept",
        "output": {
          "effective": [
            [
              0,
              1
            ]
          ]
        }
      }
    },
