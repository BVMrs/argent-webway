{
  "$schema": "../vector.schema.json",
  "format": "webway-vectors/v0",
  "kind": "blob/ranges",
  "description": "Validate the ranges of a Fetch request and compute its effective ranges for a blob of the given size. Input {\"ranges\": any JSON, \"size\": n}. Output {\"effective\": [[start, end], …]}. Reject InvalidParamsError.",
