{
  "$schema": "../vector.schema.json",
  "format": "webway-vectors/v0",
  "kind": "stream/observe",
  "description": "Requester side of a task stream. Input {applied (last seq applied, or null), received (in arrival order; kind task = snapshot), streamEnded}. Processing stops at the first gap. Output {applied, finished (a terminal state was applied in this input), action (none or resubscribe), fromSeq (with resubscribe)}. ",
  "spec": "profile.md#71-what-ends-a-stream",
  "cases": [
    {"id":"complete","description":"Snapshot, update, terminal event: finished","requirements":["PROF-024","PROF-028"],"input":{"applied":null,"received":[{"seq":0,"kind":"task"},{"seq":1,"kind":"event"},{"seq":2,"kind":"event","terminal":true}],"streamEnded":true},"expect":{"result":"accept","output":{"applied":2,"finished":true,"action":"none"}}},
    {"id":"end-without-terminal","description":"Stream ends without a terminal event: disconnection, resubscribe","requirements":["PROF-024"],"input":{"applied":null,"received":[{"seq":0,"kind":"task"},{"seq":1,"kind":"event"}],"streamEnded":true},"expect":{"result":"accept","output":{"applied":1,"finished":false,"action":"resubscribe","fromSeq":2}}},
    {"id":"end-immediately","description":"Stream ends with nothing received: resubscribe from the next seq","requirements":["PROF-024"],"input":{"applied":5,"received":[],"streamEnded":true},"expect":{"result":"accept","output":{"applied":5,"finished":false,"action":"resubscribe","fromSeq":6}}},
    {"id":"end-nothing-applied","description":"Nothing ever applied and the stream ends: resubscribe from 0","requirements":["PROF-024"],"input":{"applied":null,"received":[],"streamEnded":true},"expect":{"result":"accept","output":{"applied":null,"finished":false,"action":"resubscribe","fromSeq":0}}},
    {"id":"open-stream","description":"Stream still open, no terminal yet: keep reading","requirements":["PROF-028"],"input":{"applied":null,"received":[{"seq":0,"kind":"task"},{"seq":1,"kind":"event"}],"streamEnded":false},"expect":{"result":"accept","output":{"applied":1,"finished":false,"action":"none"}}},
    {"id":"duplicates-ignored","description":"Events already applied are ignored","requirements":["PROF-028"],"input":{"applied":3,"received":[{"seq":2,"kind":"event"},{"seq":3,"kind":"event"},{"seq":4,"kind":"event"}],"streamEnded":false},"expect":{"result":"accept","output":{"applied":4,"finished":false,"action":"none"}}},
    {"id":"gap","description":"A gap is not applied: resubscribe from the first missing seq","requirements":["PROF-028"],"input":{"applied":3,"received":[{"seq":5,"kind":"event"},{"seq":6,"kind":"event"}],"streamEnded":false},"expect":{"result":"accept","output":{"applied":3,"finished":false,"action":"resubscribe","fromSeq":4}}},
    {"id":"gap-after-progress","description":"Apply up to the gap, then resubscribe","requirements":["PROF-028"],"input":{"applied":3,"received":[{"seq":4,"kind":"event"},{"seq":6,"kind":"event","terminal":true}],"streamEnded":true},"expect":{"result":"accept","output":{"applied":4,"finished":false,"action":"resubscribe","fromSeq":5}}},
    {"id":"snapshot-resets","description":"A snapshot replaces the view and resets the cursor","requirements":["PROF-028"],"input":{"applied":3,"received":[{"seq":7,"kind":"task"},{"seq":8,"kind":"event","terminal":true}],"streamEnded":true},"expect":{"result":"accept","output":{"applied":8,"finished":true,"action":"none"}}},
    {"id":"terminal-snapshot","description":"A snapshot in a terminal state finishes the task","requirements":["PROF-024","PROF-028"],"input":{"applied":null,"received":[{"seq":4,"kind":"task","terminal":true}],"streamEnded":true},"expect":{"result":"accept","output":{"applied":4,"finished":true,"action":"none"}}},
    {"id":"first-event-not-zero","description":"With nothing applied, an event other than seq 0 is a gap","requirements":["PROF-028"],"input":{"applied":null,"received":[{"seq":2,"kind":"event"}],"streamEnded":false},"expect":{"result":"accept","output":{"applied":null,"finished":false,"action":"resubscribe","fromSeq":0}}}
  ]
}
