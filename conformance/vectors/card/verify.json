{
  "$schema": "../vector.schema.json",
  "format": "webway-vectors/v0",
  "kind": "card/verify",
  "description": "Card signature policy before cryptographic verification. Input {signed, protected (decoded JWS protected header), policyRequiresSignature, jkuAllowList?}. Accept when the node may go on to verify (or use an unsigned card), reject when it must not use the card.",
  "spec": "profile.md#5-agent-card",
  "cases": [
    {"id":"eddsa","description":"EdDSA is allowed","requirements":["PROF-011"],"input":{"signed":true,"protected":{"alg":"EdDSA","kid":"owner-b-1","typ":"JOSE"},"policyRequiresSignature":true},"expect":{"result":"accept"}},
    {"id":"es256","description":"ES256 is allowed when verifying","requirements":["PROF-011"],"input":{"signed":true,"protected":{"alg":"ES256","kid":"owner-b-1","typ":"JOSE"},"policyRequiresSignature":true},"expect":{"result":"accept"}},
    {"id":"hs256","description":"HMAC algorithms are refused","requirements":["PROF-011"],"input":{"signed":true,"protected":{"alg":"HS256","kid":"owner-b-1","typ":"JOSE"},"policyRequiresSignature":true},"expect":{"result":"reject"}},
    {"id":"hs512","description":"HMAC algorithms are refused","requirements":["PROF-011"],"input":{"signed":true,"protected":{"alg":"HS512","kid":"owner-b-1","typ":"JOSE"},"policyRequiresSignature":false},"expect":{"result":"reject"}},
    {"id":"none","description":"alg none is refused","requirements":["PROF-011"],"input":{"signed":true,"protected":{"alg":"none","kid":"owner-b-1","typ":"JOSE"},"policyRequiresSignature":false},"expect":{"result":"reject"}},
    {"id":"rs256","description":"Algorithms outside the allow-list are refused","requirements":["PROF-011"],"input":{"signed":true,"protected":{"alg":"RS256","kid":"owner-b-1","typ":"JOSE"},"policyRequiresSignature":true},"expect":{"result":"reject"}},
    {"id":"unsigned-required","description":"Fail closed on an unsigned card when policy requires a signature","requirements":["PROF-011"],"input":{"signed":false,"policyRequiresSignature":true},"expect":{"result":"reject"}},
    {"id":"unsigned-optional","description":"An unsigned card is usable when policy does not require a signature","requirements":["PROF-011"],"input":{"signed":false,"policyRequiresSignature":false},"expect":{"result":"accept"}},
    {"id":"jku-not-allowed","description":"A jku outside the allow-list is not fetched","requirements":["PROF-011"],"input":{"signed":true,"protected":{"alg":"EdDSA","kid":"owner-b-1","typ":"JOSE","jku":"https://evil.example/jwks.json"},"policyRequiresSignature":true,"jkuAllowList":["https://beta.example.org/.well-known/jwks.json"]},"expect":{"result":"reject"}},
    {"id":"jku-no-list","description":"A jku with no allow-list is not fetched","requirements":["PROF-011"],"input":{"signed":true,"protected":{"alg":"EdDSA","kid":"owner-b-1","typ":"JOSE","jku":"https://beta.example.org/.well-known/jwks.json"},"policyRequiresSignature":true},"expect":{"result":"reject"}},
    {"id":"jku-allowed","description":"A jku on the allow-list may be fetched","requirements":["PROF-011"],"input":{"signed":true,"protected":{"alg":"EdDSA","kid":"owner-b-1","typ":"JOSE","jku":"https://beta.example.org/.well-known/jwks.json"},"policyRequiresSignature":true,"jkuAllowList":["https://beta.example.org/.well-known/jwks.json"]},"expect":{"result":"accept"}}
  ]
}
