{
  "$schema": "../vector.schema.json",
  "format": "webway-vectors/v0",
  "kind": "mailbox/card",
  "description": "Agent Card parameters of mailbox/v0 (spec §3.1). Input {\"params\": <the params object of the card's mailbox extension entry>}. Accept with {\"hosts\": <number of hosts>}; reject (no error name: the node only stops using the agent's hosts) when MBX-001 is broken.",
  "spec": "ext/mailbox.md#31-agent-card-parameters",
  "cases": [
    { "id": "one-host", "description": "Deposit key and one host", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc", "hosts": [ { "agent": "wwa:hostagentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK" } ] } },
      "expect": { "result": "accept", "output": { "hosts": 1 } } },
    { "id": "no-hosts", "description": "Empty host list: deposits only at the agent's own node", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc", "hosts": [] } },
      "expect": { "result": "accept", "output": { "hosts": 0 } } },
    { "id": "max-hosts", "description": "MAX_HOSTS (4) hosts", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc", "hosts": [
        { "agent": "wwa:hostagentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK" }, { "agent": "wwa:hostagentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkiTBz1ymuepAQ4HEHYSF1H8quG5GLVVQR3djdX3mDooWp" },
        { "agent": "wwa:otheragentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK" }, { "agent": "wwa:senderaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkiTBz1ymuepAQ4HEHYSF1H8quG5GLVVQR3djdX3mDooWp" } ] } },
      "expect": { "result": "accept", "output": { "hosts": 4 } } },
    { "id": "too-many-hosts", "description": "Five hosts", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc", "hosts": [
        { "agent": "wwa:hostagentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK" }, { "agent": "wwa:hostagentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkiTBz1ymuepAQ4HEHYSF1H8quG5GLVVQR3djdX3mDooWp" },
        { "agent": "wwa:otheragentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK" }, { "agent": "wwa:senderaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkiTBz1ymuepAQ4HEHYSF1H8quG5GLVVQR3djdX3mDooWp" },
        { "agent": "wwa:recipientaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK" } ] } },
      "expect": { "result": "reject" } },
    { "id": "unknown-members", "description": "Unknown members in params and in a host entry are ignored", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc", "future": 1, "hosts": [ { "agent": "wwa:hostagentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK", "priority": 2 } ] } },
      "expect": { "result": "accept", "output": { "hosts": 1 } } },
    { "id": "no-params", "description": "Extension listed without params", "requirements": ["MBX-001"],
      "input": {},
      "expect": { "result": "reject" } },
    { "id": "no-deposit-key", "description": "depositKey missing", "requirements": ["MBX-001"],
      "input": { "params": { "hosts": [] } },
      "expect": { "result": "reject" } },
    { "id": "deposit-key-padded", "description": "depositKey with base64 padding", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc=", "hosts": [] } },
      "expect": { "result": "reject" } },
    { "id": "deposit-key-short", "description": "depositKey of 31 bytes", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "hosts": [] } },
      "expect": { "result": "reject" } },
    { "id": "deposit-key-trailing-bits", "description": "depositKey whose unused trailing bits are not zero", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAB", "hosts": [] } },
      "expect": { "result": "reject" } },
    { "id": "hosts-missing", "description": "hosts member missing", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc" } },
      "expect": { "result": "reject" } },
    { "id": "hosts-not-array", "description": "hosts is an object", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc", "hosts": { "agent": "wwa:hostagentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK" } } },
      "expect": { "result": "reject" } },
    { "id": "host-no-owner", "description": "Host entry without owner", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc", "hosts": [ { "agent": "wwa:hostagentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" } ] } },
      "expect": { "result": "reject" } },
    { "id": "host-agent-uppercase", "description": "Host agent ID in uppercase base32", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc", "hosts": [ { "agent": "wwa:HOSTAGENTAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK" } ] } },
      "expect": { "result": "reject" } },
    { "id": "host-node-is-agent-id", "description": "Host node given as a wwa: identifier", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc", "hosts": [ { "agent": "wwa:hostagentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwa:hostagentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK" } ] } },
      "expect": { "result": "reject" } },
    { "id": "host-owner-not-ed25519", "description": "Owner is a did:key of another key type (secp256k1)", "requirements": ["MBX-001"],
      "input": { "params": { "depositKey": "1AM2PI4e9mxL8TPSHJnDBbgr_8OyBdHvzHk_m5aroSc", "hosts": [ { "agent": "wwa:hostagentaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "node": "wwn:hostnodeaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "owner": "did:key:zQ3shokFTS3brHcDQrn82RUDfCZESWL1ZdCEJwekUDPQiYBme" } ] } },
      "expect": { "result": "reject" } }
  ]
}
