{
  "$schema": "../vector.schema.json",
  "format": "webway-vectors/v0",
  "kind": "mailbox/path",
  "description": "Paths for the next attempt of an outbox entry (spec \u00a79.3). Input: entry state, whether the recipient node is reachable now, and the recipient's declared hosts in order, each with who operates it (as established from its certificate chain), whether the sender's owner allow-lists it, whether its certificate chain verified, whether the sender holds an unexpired deposit token for the recipient, and whether it failed for this entry. Accept with the ordered list of paths to try.",
  "spec": "ext/mailbox.md#93-paths",
  "cases": [
    {"id":"direct-then-host","description":"Direct first, then the host","requirements":["MBX-063"],"input":{"state":"queued","direct":true,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":["direct","host:0"]}}},
    {"id":"host-only","description":"Recipient unreachable: the host","requirements":["MBX-063"],"input":{"state":"queued","direct":false,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":["host:0"]}}},
    {"id":"nothing","description":"Unreachable and no hosts: wait","requirements":["MBX-063"],"input":{"state":"pending","direct":false,"hosts":[]},"expect":{"result":"accept","output":{"paths":[]}}},
    {"id":"sender-owner-host","description":"Host operated by the sender's owner is content-trusted","requirements":["MBX-004"],"input":{"state":"queued","direct":false,"hosts":[{"operator":"sender-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":["host:0"]}}},
    {"id":"third-party-host","description":"Host of another owner, not allow-listed: not used for unsealed envelopes","requirements":["MBX-004"],"input":{"state":"queued","direct":false,"hosts":[{"operator":"other","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":[]}}},
    {"id":"third-party-allow-listed","description":"Host of another owner that the sender's owner allow-lists","requirements":["MBX-004"],"input":{"state":"queued","direct":false,"hosts":[{"operator":"other","allowListed":true,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":["host:0"]}}},
    {"id":"chain-invalid","description":"Operator cannot be established from certificates: not used","requirements":["MBX-005"],"input":{"state":"queued","direct":false,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":false,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":[]}}},
    {"id":"chain-invalid-allow-listed","description":"Allow-listing does not replace the certificate chain","requirements":["MBX-005"],"input":{"state":"queued","direct":false,"hosts":[{"operator":"other","allowListed":true,"chainValid":false,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":[]}}},
    {"id":"no-token","description":"No deposit token for the recipient: host not eligible","requirements":["MBX-063"],"input":{"state":"queued","direct":false,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":false,"failed":false}]},"expect":{"result":"accept","output":{"paths":[]}}},
    {"id":"failed-host","description":"Host failed for this entry with a non-retryable CUSTODY error: skipped","requirements":["MBX-064"],"input":{"state":"pending","direct":false,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":true},{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":["host:1"]}}},
    {"id":"declaration-order","description":"Eligible hosts in declaration order","requirements":["MBX-063","MBX-004"],"input":{"state":"queued","direct":false,"hosts":[{"operator":"other","allowListed":false,"chainValid":true,"token":true,"failed":false},{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":false},{"operator":"sender-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":["host:1","host:2"]}}},
    {"id":"stored-direct","description":"Stored at a host: keep trying direct","requirements":["MBX-065"],"input":{"state":"stored","direct":true,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":["direct"]}}},
    {"id":"stored-no-redeposit","description":"Stored at a host, recipient unreachable: no other host, wait","requirements":["MBX-065"],"input":{"state":"stored","direct":false,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":[]}}},
    {"id":"received-direct","description":"Request received by the recipient node: direct only, to recover the answer","requirements":["MBX-066"],"input":{"state":"received","direct":true,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":["direct"]}}},
    {"id":"received-unreachable","description":"Request received, recipient unreachable: wait","requirements":["MBX-066"],"input":{"state":"received","direct":false,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":[]}}},
    {"id":"delivered","description":"Final state: no paths","requirements":["MBX-063"],"input":{"state":"delivered","direct":true,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":[]}}},
    {"id":"expired","description":"Final state: no paths","requirements":["MBX-063"],"input":{"state":"expired","direct":true,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":[]}}},
    {"id":"withdrawn","description":"Final state: no paths","requirements":["MBX-063"],"input":{"state":"withdrawn","direct":true,"hosts":[{"operator":"recipient-owner","allowListed":false,"chainValid":true,"token":true,"failed":false}]},"expect":{"result":"accept","output":{"paths":[]}}}
  ]
}
