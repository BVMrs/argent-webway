{
  "$schema": "../vector.schema.json",
  "format": "webway-vectors/v0",
  "kind": "bind/svc",
  "description": "Service parameters of a request (binding body svc). Input {svc (absent means no svc member), op, supported (A2A versions the responder accepts)}. Output {a2aVersion, extensions (from a2a-extensions, in order), fromSeq (from webway-from-seq, SubscribeToTask only)}. The size of the svc object is that of its JCS serialisation in UTF-8.",
  "spec": "binding-webway-quic.md#7-service-parameters",
  "cases": [
    {"id":"version-only","description":"a2a-version only","requirements":["BIND-018"],"input":{"svc":{"a2a-version":"1.0"},"op":"GetTask","supported":["1.0"]},"expect":{"result":"accept","output":{"a2aVersion":"1.0","extensions":[]}}},
    {"id":"absent-svc","description":"No svc at all means version 0.3","requirements":["BIND-018","PROF-054"],"input":{"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"VersionNotSupportedError"}},
    {"id":"absent-version","description":"svc without a2a-version means 0.3","requirements":["BIND-018","PROF-054"],"input":{"svc":{},"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"VersionNotSupportedError"}},
    {"id":"empty-version","description":"An empty a2a-version means 0.3","requirements":["BIND-018","PROF-054"],"input":{"svc":{"a2a-version":""},"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"VersionNotSupportedError"}},
    {"id":"version-0-3","description":"Explicit 0.3 is not supported by the profile","requirements":["BIND-018","PROF-054"],"input":{"svc":{"a2a-version":"0.3"},"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"VersionNotSupportedError"}},
    {"id":"version-unsupported-minor","description":"A minor the responder does not support","requirements":["PROF-054"],"input":{"svc":{"a2a-version":"1.1"},"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"VersionNotSupportedError"}},
    {"id":"extensions","description":"a2a-extensions is a comma-separated list","requirements":["BIND-017"],"input":{"svc":{"a2a-version":"1.0","a2a-extensions":"https://github.com/BVMrs/argent-webway/spec/ext/mailbox/v0,https://example.com/ext/geo/v1"},"op":"SendMessage","supported":["1.0"]},"expect":{"result":"accept","output":{"a2aVersion":"1.0","extensions":["https://github.com/BVMrs/argent-webway/spec/ext/mailbox/v0","https://example.com/ext/geo/v1"]}}},
    {"id":"from-seq","description":"webway-from-seq on SubscribeToTask","requirements":["BIND-017"],"input":{"svc":{"a2a-version":"1.0","webway-from-seq":"17"},"op":"SubscribeToTask","supported":["1.0"]},"expect":{"result":"accept","output":{"a2aVersion":"1.0","extensions":[],"fromSeq":17}}},
    {"id":"unknown-name-ignored","description":"Unknown parameter names are ignored","requirements":["BIND-017"],"input":{"svc":{"a2a-version":"1.0","x-trace":"abc"},"op":"GetTask","supported":["1.0"]},"expect":{"result":"accept","output":{"a2aVersion":"1.0","extensions":[]}}},
    {"id":"uppercase-key","description":"Keys must be lowercase on this binding","requirements":["BIND-017"],"input":{"svc":{"A2A-Version":"1.0"},"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"InvalidRequestError"}},
    {"id":"non-string-value","description":"Values must be strings","requirements":["BIND-017"],"input":{"svc":{"a2a-version":1},"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"InvalidRequestError"}},
    {"id":"key-bad-char","description":"Keys are [a-z0-9-] only","requirements":["BIND-017"],"input":{"svc":{"a2a-version":"1.0","x_trace":"1"},"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"InvalidRequestError"}},
    {"id":"key-too-long","description":"Keys are at most 64 characters","requirements":["BIND-017"],"input":{"svc":{"a2a-version":"1.0","kxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx":"1"},"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"InvalidRequestError"}},
    {"id":"key-max-length","description":"A 64-character key is allowed","requirements":["BIND-017"],"input":{"svc":{"a2a-version":"1.0","kxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx":"1"},"op":"GetTask","supported":["1.0"]},"expect":{"result":"accept","output":{"a2aVersion":"1.0","extensions":[]}}},
    {"id":"value-too-long","description":"Values are at most 4096 bytes","requirements":["BIND-017"],"input":{"svc":{"a2a-version":"1.0","x-pad":""},"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"InvalidRequestError"}},
    {"id":"value-max-length","description":"A 4096-byte value is allowed","requirements":["BIND-017"],"input":{"svc":{"a2a-version":"1.0","x-pad":""},"op":"GetTask","supported":["1.0"]},"expect":{"result":"accept","output":{"a2aVersion":"1.0","extensions":[]}}},
    {"id":"svc-too-large","description":"The svc object is at most 16384 bytes","requirements":["BIND-017"],"input":{"svc":{"a2a-version":"1.0","x-pad-0":"","x-pad-1":"","x-pad-2":"","x-pad-3":"","x-pad-4":""},"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"InvalidRequestError"}},
    {"id":"svc-not-object","description":"svc must be an object","requirements":["BIND-017"],"input":{"svc":["a2a-version","1.0"],"op":"GetTask","supported":["1.0"]},"expect":{"result":"reject","error":"InvalidRequestError"}}
  ]
}
